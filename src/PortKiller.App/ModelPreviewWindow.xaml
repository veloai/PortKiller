<Window x:Class="PortKiller.App.ModelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PKP 3D 미리보기"
        Width="360" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="600" Top="200">

    <!-- 3D 모델이 "투명 창" 위에서 배경 없이 그려지는지 확인하는 시험용 창. model-preview 옵션으로만 열린다. -->
    <Viewport3D x:Name="View" ClipToBounds="False" MouseLeftButtonDown="View_MouseLeftButtonDown">
        <Viewport3D.Camera>
            <PerspectiveCamera Position="0,0.1,5.2" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="30" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup x:Name="Scene">
                    <AmbientLight Color="#FFB0B0B0" />
                    <DirectionalLight Color="#FF8C8C8C" Direction="-0.4,-0.6,-1" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
    </Viewport3D>
</Window>

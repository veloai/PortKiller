<Window x:Class="PortKiller.App.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💬 물어보기"
        Width="460" Height="420"
        MinWidth="360" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F4"
        FontFamily="Malgun Gothic"
        FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 어디로 물어보는지 늘 보이게 둔다. 열쇠를 둘 다 등록해 두면
             지금 어느 쪽이 도는지 모른 채 요금이 나간다. -->
        <TextBlock x:Name="ProviderLabel"
                   Grid.Row="0"
                   Foreground="#FF8A8A80"
                   FontSize="11"
                   Margin="2,0,0,8"
                   Text="—" />

        <!-- 답이 나오는 곳. 읽기 전용이지만 긁어 갈 수 있어야 쓸모가 있다. -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFE0E0DA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="AnswerText"
                         AutomationProperties.AutomationId="AnswerText"
                         Text="무엇이든 물어봐. 아래에 적고 엔터를 누르면 돼."
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   AutomationProperties.AutomationId="StatusText"
                   Foreground="#FFB4534B"
                   FontSize="11"
                   Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   Text="" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 엔터로 보낸다. 줄바꿈은 Shift+Enter 로 남겨 둔다 —
                 긴 질문에서 엔터가 전송이면 문단을 못 쓴다. -->
            <TextBox x:Name="PromptBox"
                     AutomationProperties.AutomationId="PromptBox"
                     Grid.Column="0"
                     Padding="10,8"
                     MaxHeight="90"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="PromptBox_PreviewKeyDown" />

            <Button x:Name="SendButton"
                    AutomationProperties.AutomationId="SendButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,8"
                    Content="보내기"
                    Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>

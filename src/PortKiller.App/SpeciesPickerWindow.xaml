<Window x:Class="PortKiller.App.SpeciesPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧺 어떤 아이를 키울까요?"
        Width="860" Height="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F4"
        FontFamily="Malgun Gothic, Segoe UI Emoji"
        FontSize="13">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="Bold" Foreground="#FF2F4F2A" Text="어떤 아이를 키울까요?" />
            <TextBlock x:Name="SubHeading" Foreground="#FF8A8A80" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 종 카드: 코드가 채운다 (SpeciesPickerWindow.xaml.cs) -->
        <UniformGrid x:Name="Cards" Grid.Row="1" Rows="1" />

        <TextBlock x:Name="Footer" Grid.Row="2" Margin="0,12,0,0" Foreground="#FF8A8A80" FontSize="11" TextWrapping="Wrap" />
    </Grid>
</Window>

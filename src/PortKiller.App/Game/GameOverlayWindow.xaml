<Window x:Class="PortKiller.App.Game.GameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortKiller Game HUD"
        Width="380" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!-- 반투명 HUD 캡슐 바 -->
    <Grid>
        <Border x:Name="HudCapsule"
                Background="#D9111822"
                BorderBrush="#FF00E5FF"
                BorderThickness="1.5"
                CornerRadius="20"
                Padding="14,8"
                Cursor="Hand"
                MouseLeftButtonDown="HudCapsule_MouseLeftButtonDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 상단 상태 바 (패드 & 마이크 & 배터리) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 패드 연결 & 배터리 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock x:Name="PadStatusText" Text="PS5 DualSense" FontSize="11" Foreground="#CCD6E0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BatteryText" Text=" (100%)" FontSize="11" Foreground="#53E3A6" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- 마이크 PTT 상태 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MicIcon" Text="🎙️" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock x:Name="MicStatusText" Text="패드 마이크 준비됨" FontSize="11" Foreground="#8B9EB0"/>
                    </StackPanel>

                    <!-- 닫기 버튼 -->
                    <Button Grid.Column="2" Content="✕" Width="16" Height="16"
                            Background="Transparent" Foreground="#7A8D9F" BorderThickness="0"
                            FontSize="10" Cursor="Hand" Click="CloseHud_Click"/>
                </Grid>

                <!-- 하단 보이스 실행 알림 토스트 (말하면 실시간 발동 애니메이션) -->
                <Border x:Name="VoiceToastBorder" Grid.Row="1" Margin="0,6,0,0"
                        Background="#2600E5FF" CornerRadius="8" Padding="8,4"
                        Visibility="Visible">
                    <TextBlock x:Name="VoiceToastText"
                               Text="🗣️ 보이스 대기 중 ('물약', '지도' 말해보세요)"
                               Foreground="#00E5FF" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

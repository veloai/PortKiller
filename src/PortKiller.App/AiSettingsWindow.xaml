<Window x:Class="PortKiller.App.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 AI 설정"
        Width="460" Height="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F4"
        FontFamily="Malgun Gothic"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF2F4F2A" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#FF8A8A80" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE0E0DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- 어디로 물어볼지 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="어디로 물어볼까요" />
                        <RadioButton x:Name="UseGemini"
                                     AutomationProperties.AutomationId="UseGemini"
                                     GroupName="Provider"
                                     Content="Gemini (Google)"
                                     Margin="0,0,0,6" />
                        <RadioButton x:Name="UseOpenAi"
                                     AutomationProperties.AutomationId="UseOpenAi"
                                     GroupName="Provider"
                                     Content="OpenAI" />
                    </StackPanel>
                </Border>

                <!-- Gemini -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Gemini 열쇠" />
                        <TextBlock x:Name="GeminiState"
                                   AutomationProperties.AutomationId="GeminiState"
                                   Style="{StaticResource Hint}"
                                   Text="등록되지 않음" />
                        <PasswordBox x:Name="GeminiKey"
                                     AutomationProperties.AutomationId="GeminiKey"
                                     Padding="8,6"
                                     Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="모델 이름" />
                        <TextBox x:Name="GeminiModel"
                                 AutomationProperties.AutomationId="GeminiModel"
                                 Padding="8,6" />
                    </StackPanel>
                </Border>

                <!-- OpenAI -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="OpenAI 열쇠" />
                        <TextBlock x:Name="OpenAiState"
                                   AutomationProperties.AutomationId="OpenAiState"
                                   Style="{StaticResource Hint}"
                                   Text="등록되지 않음" />
                        <PasswordBox x:Name="OpenAiKey"
                                     AutomationProperties.AutomationId="OpenAiKey"
                                     Padding="8,6"
                                     Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="모델 이름" />
                        <TextBox x:Name="OpenAiModel"
                                 AutomationProperties.AutomationId="OpenAiModel"
                                 Padding="8,6" />
                    </StackPanel>
                </Border>

                <!-- 말투 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="말투" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="펫이 어떤 투로 답할지 정해요. 길게 답하지 말라고 적어 두면 창이 덜 답답해요." />
                        <TextBox x:Name="Persona"
                                 AutomationProperties.AutomationId="Persona"
                                 Padding="8,6"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- 어디에 저장되나 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="열쇠는 어디에 저장되나요" />
                        <TextBlock Style="{StaticResource Hint}">
                            윈도우 기능으로 <Run FontWeight="Bold">암호화해서</Run> 내 계정 폴더에만 둡니다.
                            파일을 다른 PC나 다른 계정으로 옮기면 풀리지 않아요.
                            질문과 답은 저장하지 않습니다.
                        </TextBlock>
                        <TextBlock x:Name="KeyPathText"
                                   Style="{StaticResource Hint}"
                                   Margin="0"
                                   Text="" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FFEFEFEA" BorderBrush="#FFE0E0DA" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ClearKeysButton"
                        AutomationProperties.AutomationId="ClearKeysButton"
                        Grid.Column="0"
                        Padding="12,6"
                        Content="열쇠 전부 지우기"
                        Click="ClearKeysButton_Click" />

                <TextBlock x:Name="SaveState"
                           AutomationProperties.AutomationId="SaveState"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Foreground="#FF2F4F2A"
                           FontSize="11"
                           Text="" />

                <Button x:Name="SaveButton"
                        AutomationProperties.AutomationId="SaveButton"
                        Grid.Column="2"
                        Padding="20,6"
                        Content="저장"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

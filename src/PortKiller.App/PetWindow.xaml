<Window x:Class="PortKiller.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PortKiller.App"
        Title="PortKiller Pet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!-- 화면 전체를 덮는 투명 판. 그림이 그려진 자리만 클릭을 받고
         나머지는 윈도우가 알아서 뒤 창으로 넘긴다. (docs/verification/clickthrough.md) -->
    <Canvas x:Name="Stage">

        <!-- 응아는 PoopLayer 에 코드로 하나씩 추가된다. 펫보다 뒤에 그려지도록 먼저 둔다. -->
        <Canvas x:Name="PoopLayer" />

        <Border x:Name="PetBody"
                Width="104" Height="104"
                CornerRadius="52"
                Background="#FF7BC96F"
                BorderBrush="#FF3F7A38"
                BorderThickness="3"
                Cursor="Hand"
                MouseLeftButtonDown="PetBody_MouseLeftButtonDown"
                MouseMove="PetBody_MouseMove"
                MouseLeftButtonUp="PetBody_MouseLeftButtonUp">
            <!-- 알이면 알(복셀), 아니면 레서판다(복셀). 알 그림은 코드가 BodyLayers 에 넣는다. -->
            <Grid x:Name="BodyLayers">
                <local:PandaView x:Name="Panda" Visibility="Collapsed" />
            </Grid>

            <!-- 돌보기 메뉴. 펫을 우클릭하면 열린다. -->
            <Border.ContextMenu>
                <ContextMenu x:Name="CareMenu" Opened="CareMenu_Opened">
                    <MenuItem Header="🍚  먹이"   Tag="Feed"     Click="CareMenu_Click" />
                    <MenuItem Header="🍪  간식"   Tag="Snack"    Click="CareMenu_Click" />
                    <MenuItem Header="🎾  놀기"   Tag="Play"     Click="CareMenu_Click" />
                    <Separator />
                    <MenuItem Header="🧹  청소"   Tag="Clean"    Click="CareMenu_Click" />
                    <MenuItem Header="💊  약"     Tag="Medicine" Click="CareMenu_Click" />
                    <MenuItem Header="😴  재우기" Tag="Sleep"    Click="CareMenu_Click" />
                    <Separator />
                    <MenuItem Header="📊  상태 보기/숨기기" Click="StatusMenu_Click" />
                    <!-- 트레이 메뉴는 윈도우 11 숨김 영역에 들어가서 자동 검사가 못 닿는다.
                         펫 우클릭 메뉴는 닿으므로 같은 기능을 여기에도 둔다. -->
                    <MenuItem x:Name="AskMenuItem"
                              AutomationProperties.AutomationId="AskMenuItem"
                              Header="💬  물어보기"
                              Click="AskMenu_Click" />
                    <Separator />
                    <MenuItem Header="⏻  종료" Click="QuitMenu_Click" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- 말풍선. 펫을 따라다니며, 할 말이 없으면 숨는다. -->
        <Border x:Name="SpeechBubble"
                Visibility="Collapsed"
                Background="#FFFFFFFF"
                BorderBrush="#FF3F7A38"
                BorderThickness="2"
                CornerRadius="12"
                Padding="12,7"
                MaxWidth="260"
                Cursor="Hand"
                MouseLeftButtonDown="SpeechBubble_Clicked">
            <TextBlock x:Name="SpeechText"
                       Foreground="#FF1E1E1E"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 상태 카드. 트레이 "상태 보기"와 펫 우클릭 메뉴로 켜고 끈다. -->
        <local:StatusCard x:Name="DebugPanel" />
    </Canvas>
</Window>

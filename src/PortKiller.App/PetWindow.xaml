<Window x:Class="PortKiller.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortKiller Pet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!-- 이 Canvas 가 화면 전체를 덮는다. 보이는 것은 그 위에 올린 조각들뿐이고,
         나머지 영역은 ClickThroughController 가 클릭을 통과시킨다. -->
    <Canvas x:Name="Stage">

        <!-- 확인용 조각 1: 펫 자리 -->
        <Border x:Name="PetBody"
                Width="96" Height="96"
                CornerRadius="48"
                Background="#FF7BC96F"
                BorderBrush="#FF3F7A38"
                BorderThickness="3"
                MouseLeftButtonDown="PetBody_MouseLeftButtonDown">
            <TextBlock x:Name="PetFace"
                       Text="🥚"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 확인용 조각 2: 떨어져 있는 두 번째 영역(응아 역할).
             이 둘 사이 빈 공간에서 뒤 창이 클릭되면 클릭 통과가 성공한 것이다. -->
        <Border x:Name="Poop"
                Width="48" Height="48"
                CornerRadius="24"
                Background="#FF8D6E4A"
                MouseLeftButtonDown="Poop_MouseLeftButtonDown" />

        <!-- 상태 표시. 지금 클릭을 받는 중인지 눈으로 확인하는 용도. -->
        <Border x:Name="DebugPanel"
                Background="#CC1E1E1E"
                CornerRadius="6"
                Padding="10,6">
            <TextBlock x:Name="DebugText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Consolas" />
        </Border>
    </Canvas>
</Window>

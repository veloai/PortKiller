<Window x:Class="PortKiller.App.AlfaLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔗 ALFA 연동"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DotTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- 제목: 영어 + 한국어 이름 -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
            <TextBlock Style="{StaticResource DotTitleText}" Text="ALFA LINK" />
            <TextBlock Style="{StaticResource DotBodyText}" Text="펫 연동" VerticalAlignment="Bottom" Margin="8,0,0,3" />
        </StackPanel>

        <Border Style="{StaticResource DotCardBorder}">
            <StackPanel>

                <!-- STATUS 줄: 도장 + 상태, 오른쪽에 대기 시간 -->
                <TextBlock Style="{StaticResource DotLabelText}" Text="STATUS" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               AutomationProperties.AutomationId="AlfaLinkStatus"
                               Style="{StaticResource DotValueText}"
                               FontSize="18"
                               Text="░ OFF" />
                    <TextBlock x:Name="ClockText"
                               Grid.Column="1"
                               AutomationProperties.AutomationId="AlfaLinkClock"
                               Style="{StaticResource DotValueText}"
                               FontSize="18"
                               Foreground="{StaticResource DotGoldLight}"
                               Visibility="Collapsed"
                               Text="10:00" />
                </Grid>

                <!-- ① 미연동 -->
                <StackPanel x:Name="OffPanel" AutomationProperties.AutomationId="AlfaLinkOffPanel">
                    <TextBlock Style="{StaticResource DotLabelText}" Text="DEVICE · 기기 이름" />
                    <TextBox x:Name="DeviceBox"
                             AutomationProperties.AutomationId="AlfaLinkDevice"
                             Style="{StaticResource DotTextBox}"
                             MaxLength="60" />
                    <TextBlock Style="{StaticResource DotLabelText}" Text="PET · 펫" />
                    <TextBlock x:Name="PetText"
                               AutomationProperties.AutomationId="AlfaLinkPet"
                               Style="{StaticResource DotValueText}"
                               FontFamily="{StaticResource DotBodyFont}"
                               FontSize="13" />
                    <TextBlock Style="{StaticResource DotLabelText}" Text="ADDRESS · ALFA 주소" />
                    <TextBox x:Name="AddressBox"
                             AutomationProperties.AutomationId="AlfaLinkAddress"
                             Style="{StaticResource DotTextBox}" />
                    <TextBlock Style="{StaticResource DotBodyText}"
                               Margin="0,10,0,12"
                               Text="로그인 없이, ALFA 설정 › 기기에서 확인 코드를 보고 승인하면 이 펫 전용 키를 받아요." />
                    <Button x:Name="RequestButton"
                            AutomationProperties.AutomationId="AlfaLinkRequest"
                            Style="{StaticResource DotPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Content="▦ REQUEST · 연동 요청 ▦"
                            Click="RequestButton_Click" />
                </StackPanel>

                <!-- ② 대기 -->
                <StackPanel x:Name="WaitingPanel" AutomationProperties.AutomationId="AlfaLinkWaitingPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource DotLabelText}" Text="CODE · 확인 코드" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource DotGoldFill}"
                                BorderBrush="{StaticResource DotGold}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource DotControlRadius}"
                                Height="44">
                            <TextBlock x:Name="CodeText"
                                       AutomationProperties.AutomationId="AlfaLinkCode"
                                       FontFamily="{StaticResource DotDisplayFont}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DotGoldLight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="------" />
                        </Border>
                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="AlfaLinkCopy"
                                Style="{StaticResource DotSecondaryButton}"
                                MinWidth="30" Width="30" Height="30" Padding="0"
                                Margin="8,0,0,0"
                                ToolTip="코드 복사"
                                Content="⧉"
                                Click="CopyButton_Click" />
                    </Grid>

                    <!-- DotSteps 4칸: 요청 · 코드 확인 · 승인 · 키 받기 -->
                    <UniformGrid x:Name="Steps" Columns="4" Margin="0,14,0,0" />

                    <TextBlock Style="{StaticResource DotBodyText}"
                               Margin="0,10,0,12"
                               Text="ALFA 설정 › 기기에서 같은 코드인지 보고 승인하세요. 창을 닫아도 펫이 계속 기다려요." />
                    <Button x:Name="CancelButton"
                            AutomationProperties.AutomationId="AlfaLinkCancel"
                            Style="{StaticResource DotSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Content="CANCEL · 그만두기"
                            Click="CancelButton_Click" />
                </StackPanel>

                <!-- ③ 연결 -->
                <StackPanel x:Name="LinkedPanel" AutomationProperties.AutomationId="AlfaLinkLinkedPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DotLabelText}" Text="LINKED · 연결 시각" />
                            <TextBlock x:Name="LinkedAtText"
                                       AutomationProperties.AutomationId="AlfaLinkLinkedAt"
                                       Style="{StaticResource DotValueText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource DotLabelText}" Text="LAST CHECK · 마지막 확인" />
                            <TextBlock x:Name="LastCheckText"
                                       AutomationProperties.AutomationId="AlfaLinkLastCheck"
                                       Style="{StaticResource DotValueText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource DotLabelText}" Text="DEVICE · 기기 이름" />
                    <TextBlock x:Name="LinkedDeviceText"
                               AutomationProperties.AutomationId="AlfaLinkLinkedDevice"
                               Style="{StaticResource DotValueText}"
                               FontFamily="{StaticResource DotLabelFont}"
                               FontSize="13" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckButton"
                                AutomationProperties.AutomationId="AlfaLinkCheck"
                                Style="{StaticResource DotSecondaryButton}"
                                Content="CHECK · 확인"
                                Click="CheckButton_Click" />
                        <Button x:Name="UnlinkButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="AlfaLinkUnlink"
                                Style="{StaticResource DotDangerButton}"
                                Content="UNLINK · 연동 끊기"
                                Click="UnlinkButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- 안내 한 줄(실패·거절·만료·끊김) -->
                <TextBlock x:Name="MessageText"
                           AutomationProperties.AutomationId="AlfaLinkMessage"
                           Style="{StaticResource DotBodyText}"
                           Foreground="{StaticResource DotWarn}"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ALFA dot 디자인 토큰(설계서 §13.3, §10.3). ALFA 설정 화면과 같은 색·모양을 펫 창에 쓴다.
         글꼴: 제목·숫자·코드 Doto, 이름표 JetBrains Mono, 한글 Pretendard.
         TODO(사용자 허락 뒤): Doto·JetBrains Mono·Pretendard 글꼴 파일(OFL)을 Assets/Fonts 에 넣고
         아래 FontFamily 를 pack URI 로 바꾼다. 지금은 설치된 글꼴이 있으면 쓰고, 없으면 Consolas / 맑은 고딕으로 내려간다. -->

    <!-- 색 -->
    <Color x:Key="DotCardColor">#FF141416</Color>
    <Color x:Key="DotWindowColor">#FF0C0C0D</Color>
    <Color x:Key="DotGoldColor">#FFFFB703</Color>
    <Color x:Key="DotGoldLightColor">#FFFFE7A8</Color>
    <Color x:Key="DotWarnColor">#FFFF6A4D</Color>
    <Color x:Key="DotMutedColor">#FF8D8A84</Color>
    <Color x:Key="DotInkColor">#FFF4F1EA</Color>
    <Color x:Key="DotLineColor">#FF2A2A2E</Color>

    <SolidColorBrush x:Key="DotCard" Color="{StaticResource DotCardColor}" />
    <SolidColorBrush x:Key="DotWindow" Color="{StaticResource DotWindowColor}" />
    <SolidColorBrush x:Key="DotGold" Color="{StaticResource DotGoldColor}" />
    <SolidColorBrush x:Key="DotGoldLight" Color="{StaticResource DotGoldLightColor}" />
    <SolidColorBrush x:Key="DotWarn" Color="{StaticResource DotWarnColor}" />
    <SolidColorBrush x:Key="DotMuted" Color="{StaticResource DotMutedColor}" />
    <SolidColorBrush x:Key="DotInk" Color="{StaticResource DotInkColor}" />
    <SolidColorBrush x:Key="DotLine" Color="{StaticResource DotLineColor}" />

    <!-- 모양 -->
    <CornerRadius x:Key="DotCardRadius">16</CornerRadius>
    <CornerRadius x:Key="DotControlRadius">8</CornerRadius>
    <sys:Double x:Key="DotControlHeight">28</sys:Double>

    <!-- 글꼴(없으면 다음 것으로) -->
    <FontFamily x:Key="DotDisplayFont">Doto, JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="DotLabelFont">JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="DotBodyFont">Pretendard, Malgun Gothic</FontFamily>

    <!-- 4px 도트 무늬: 4×4 칸 안에 2×2 점 하나. 채움(골드)·중립(흰 .14)·경고 세 가지 -->
    <DrawingBrush x:Key="DotGoldFill" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF3A2A00" Geometry="M0,0 H4 V4 H0 Z" />
                <GeometryDrawing Brush="{StaticResource DotGold}" Geometry="M1,1 H3 V3 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="DotNeutralFill" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource DotCard}" Geometry="M0,0 H4 V4 H0 Z" />
                <GeometryDrawing Brush="#24FFFFFF" Geometry="M1,1 H3 V3 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="DotWarnFill" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF2A1210" Geometry="M0,0 H4 V4 H0 Z" />
                <GeometryDrawing Brush="{StaticResource DotWarn}" Geometry="M1,1 H3 V3 H1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 카드 -->
    <Style x:Key="DotCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DotCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource DotLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DotCardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 글자 -->
    <Style x:Key="DotLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DotLabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource DotMuted}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="DotTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DotDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DotGoldLight}" />
    </Style>

    <Style x:Key="DotValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DotDisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource DotInk}" />
    </Style>

    <Style x:Key="DotBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DotBodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DotMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 입력: 28px, 모서리 8 -->
    <Style x:Key="DotTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource DotControlHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource DotLabelFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DotInk}" />
        <Setter Property="CaretBrush" Value="{StaticResource DotGold}" />
        <Setter Property="Background" Value="{StaticResource DotWindow}" />
        <Setter Property="BorderBrush" Value="{StaticResource DotLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource DotControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource DotGold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 버튼 공통: 28px, 모서리 8, JetBrains 대문자 -->
    <ControlTemplate x:Key="DotButtonTemplate" TargetType="Button">
        <Border x:Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource DotControlRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource DotGoldLight}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DotButtonBase" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource DotControlHeight}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{StaticResource DotLabelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DotButtonTemplate}" />
    </Style>

    <!-- 주(REQUEST): 골드 도트 채움 -->
    <Style x:Key="DotPrimaryButton" TargetType="Button" BasedOn="{StaticResource DotButtonBase}">
        <Setter Property="Background" Value="{StaticResource DotGoldFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource DotGold}" />
        <Setter Property="Foreground" Value="{StaticResource DotGoldLight}" />
    </Style>

    <!-- 보조(CANCEL·CHECK): 골드 테두리 -->
    <Style x:Key="DotSecondaryButton" TargetType="Button" BasedOn="{StaticResource DotButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DotGold}" />
        <Setter Property="Foreground" Value="{StaticResource DotGold}" />
    </Style>

    <!-- 위험(UNLINK): 경고 테두리 -->
    <Style x:Key="DotDangerButton" TargetType="Button" BasedOn="{StaticResource DotButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DotWarn}" />
        <Setter Property="Foreground" Value="{StaticResource DotWarn}" />
    </Style>
</ResourceDictionary>

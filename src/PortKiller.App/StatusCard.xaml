<UserControl x:Class="PortKiller.App.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Malgun Gothic, Segoe UI Emoji">

    <!-- 펫 상태 카드. 숫자 나열이 아니라 "지금 이 아이가 어떤가"가 한눈에 읽히게. -->
    <Border Width="248"
            Background="#E61B1E2B"
            BorderBrush="#FF3A4060"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,12">
        <StackPanel>

            <!-- 머리: 단계 + 지금 기분 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="Bold" />
                    <TextBlock x:Name="SubText" Foreground="#FF9AA3C7" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="MoodChip" CornerRadius="9" Padding="9,3" VerticalAlignment="Top">
                    <TextBlock x:Name="MoodText" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <TextBlock Grid.Column="2" Text="✕" Foreground="#FF9AA3C7" FontSize="13" Margin="10,1,0,0"
                           Cursor="Hand" ToolTip="브리핑 끝내기" VerticalAlignment="Top"
                           MouseLeftButtonDown="Close_Clicked" />
            </Grid>

            <!-- 수치 막대. 행은 코드가 채운다(Update). -->
            <StackPanel x:Name="Bars" />

            <!-- 성장 진행 -->
            <StackPanel x:Name="GrowthBox" Margin="0,8,0,0">
                <Grid>
                    <TextBlock x:Name="GrowthLabel" Foreground="#FF9AA3C7" FontSize="11" />
                    <TextBlock x:Name="GrowthValue" Foreground="#FFCBD2F0" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="6" CornerRadius="3" Background="#FF2B3050" Margin="0,3,0,0">
                    <Border x:Name="GrowthFill" CornerRadius="3" HorizontalAlignment="Left" Background="#FFB78BFF" Width="0" />
                </Border>
            </StackPanel>

            <!-- 개발 환경: Docker·컨테이너·로컬 서버. 확인 결과가 오면 보인다 -->
            <StackPanel x:Name="DevBox" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="🛠 개발 환경" Foreground="#FF9AA3C7" FontSize="11" Margin="0,0,0,4" />
                <StackPanel x:Name="DevRows" />
            </StackPanel>

            <!-- 레서판다의 한마디: 마우스가 짚는 항목에 맞춰 바뀐다 -->
            <Border Margin="0,10,0,0" CornerRadius="8" Padding="9,6" Background="#FF262B45">
                <TextBlock x:Name="Caption" Foreground="#FFEDEFFB" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- 발 -->
            <Border Height="1" Background="#FF2B3050" Margin="0,10,0,8" />
            <UniformGrid Columns="3">
                <TextBlock x:Name="FocusText"  Foreground="#FFCBD2F0" FontSize="11" />
                <TextBlock x:Name="DaysText"   Foreground="#FFCBD2F0" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock x:Name="PoopText"   Foreground="#FFCBD2F0" FontSize="11" HorizontalAlignment="Right" />
            </UniformGrid>

            <!-- 펫의 기억: 이번 주 요약 한 줄 -->
            <TextBlock x:Name="MemoryText" Foreground="#FF9AA3C7" FontSize="10.5" Margin="0,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>

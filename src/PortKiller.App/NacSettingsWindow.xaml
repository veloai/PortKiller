<Window x:Class="PortKiller.App.NacSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 NAC 자동 로그인"
        Width="460" Height="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F4"
        FontFamily="Malgun Gothic"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF2F4F2A" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#FF8A8A80" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE0E0DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Genian NAC 계정" />
                        <TextBlock x:Name="State"
                                   AutomationProperties.AutomationId="NacState"
                                   Style="{StaticResource Hint}"
                                   Text="등록되지 않음" />
                        <TextBlock Style="{StaticResource Hint}" Text="아이디" />
                        <TextBox x:Name="UserId"
                                 AutomationProperties.AutomationId="NacUserId"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Hint}" Text="비밀번호" />
                        <PasswordBox x:Name="Password"
                                     AutomationProperties.AutomationId="NacPassword"
                                     Padding="8,6"
                                     Margin="0,0,0,8" />
                        <CheckBox x:Name="Enabled"
                                  AutomationProperties.AutomationId="NacEnabled"
                                  Content="펫이 켜질 때 로그인 창이 뜨면 자동으로 입력하고 [인증]을 누른다" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="이렇게 동작해요" />
                        <TextBlock Style="{StaticResource Hint}">
                            재부팅 뒤 펫이 켜지면 2분 동안 Genian 로그인 창을 기다립니다.
                            <Run FontWeight="Bold">재부팅 때 쓰려면 트레이 메뉴의 "시작 시 자동 실행"도 켜 두세요.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}">
                            <Run FontWeight="Bold">딱 한 번만</Run> 시도합니다. 비밀번호가 틀려도 되풀이하지 않아요 (계정 잠금 방지).
                            비밀번호를 바꿨다면 여기서 새로 저장하세요.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}">
                            Genian 에이전트(Gn…) 프로그램의 창만 대상으로 하고, 다른 창에는 입력하지 않습니다.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="비밀번호는 어디에 저장되나요" />
                        <TextBlock Style="{StaticResource Hint}">
                            윈도우 기능으로 <Run FontWeight="Bold">암호화해서</Run> 내 계정 폴더에만 둡니다.
                            다른 PC나 다른 계정으로 옮기면 풀리지 않아요. 저장한 비밀번호는 화면에 다시 보여 주지 않습니다.
                        </TextBlock>
                        <TextBlock x:Name="PathText" Style="{StaticResource Hint}" Margin="0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="확인·문제 해결" />
                        <TextBlock Style="{StaticResource Hint}">
                            Genian 로그인 창이 떠 있을 때 눌러 보세요. 안 채워지면 "창 구조 저장"으로 만든 파일을 보면 원인을 알 수 있어요 (입력한 값은 담기지 않습니다).
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TryNowButton"
                                    AutomationProperties.AutomationId="NacTryNow"
                                    Padding="12,6" Margin="0,0,8,0"
                                    Content="지금 시도"
                                    Click="TryNowButton_Click" />
                            <Button x:Name="DumpButton"
                                    AutomationProperties.AutomationId="NacDump"
                                    Padding="12,6"
                                    Content="창 구조 저장"
                                    Click="DumpButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FFEFEFEA" BorderBrush="#FFE0E0DA" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ClearButton"
                        AutomationProperties.AutomationId="NacClear"
                        Grid.Column="0"
                        Padding="12,6"
                        Content="지우기"
                        Click="ClearButton_Click" />

                <TextBlock x:Name="SaveState"
                           AutomationProperties.AutomationId="NacSaveState"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Foreground="#FF2F4F2A"
                           FontSize="11" />

                <Button x:Name="SaveButton"
                        AutomationProperties.AutomationId="NacSave"
                        Grid.Column="2"
                        Padding="20,6"
                        Content="저장"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

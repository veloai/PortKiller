<Project Sdk="Microsoft.NET.Sdk">
  <!-- 윈도우 전용 계층. OS 를 건드리는 코드는 전부 여기에만 모은다.
       나중에 다른 OS 로 가면 이 프로젝트만 새로 쓰면 된다. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- 트레이 아이콘(NotifyIcon)용. 외부 NuGet 없이 기본 제공 기능만 쓰려고 켠다. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- NAC 자동 로그인(UI 자동화)용. 기본 제공 어셈블리(UIAutomationClient)만 쓰고 NuGet 은 없다.
       UseWPF 를 켜면 암시적 using(System.IO 등)이 빠져서 기존 코드가 깨지므로 참조만 건다. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortKiller.Core\PortKiller.Core.csproj" />
  </ItemGroup>
</Project>
